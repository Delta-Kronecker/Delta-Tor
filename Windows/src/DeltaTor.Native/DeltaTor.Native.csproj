<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DeltaTor.Native</RootNamespace>
    <AssemblyName>DeltaTor.Native</AssemblyName>
    <!-- Native layer: wraps hev-socks5-tunnel (WinTUN + tun2socks) in the
         ISocksTunnel shape TunnelEngine expects. The DLL is built by
         Windows/native/build-hev.sh and staged under
         Windows/native/hev-socks5-tunnel/. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeltaTor.Core\DeltaTor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- hev logs through nothing extra; keep only the core dependency. -->
  </ItemGroup>

</Project>
