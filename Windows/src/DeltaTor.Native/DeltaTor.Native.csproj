<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DeltaTor.Native</RootNamespace>
    <AssemblyName>DeltaTor.Native</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Stage-4 native layer: P/Invoke into hev-socks5-tunnel.dll (built by
         Windows/native/build-hev.sh from the vendored source) plus the
         Windows tunnel/routing implementation (WindowsTunnel, RouteManager). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeltaTor.Core\DeltaTor.Core.csproj" />
  </ItemGroup>

</Project>
