<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DeltaTor.Core</RootNamespace>
    <AssemblyName>DeltaTor.Core</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Fallback current-version for ReleaseChecker, mirroring the App's rule:
         -p:Version=X.Y.Z (release workflow) overrides this for every project. -->
    <Version>2.0.0</Version>
  </PropertyGroup>

</Project>
