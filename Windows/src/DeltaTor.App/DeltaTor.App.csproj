<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10/11 build 19041+: Se7enTun's Wintun adapter plus its
         netsh/iphlpapi calls, and its TFM itself. The WPF framework Se7enTun
         needs at runtime flows here transitively from DeltaTor.Native (which
         sets UseWPF); this project stays pure WinForms so its implicit usings
         and the WinForms/WPF type sets never collide. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DeltaTor.App</RootNamespace>
    <AssemblyName>DeltaTor</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Explorer / taskbar icon for the exe itself; the same file is copied
         next to the exe (Content below) and loaded at runtime for the window
         and the tray. -->
    <ApplicationIcon>..\..\assets\app\DeltaTor.ico</ApplicationIcon>
    <!-- The Wintun adapter and route table need Administrator. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Version is overridden by the release workflow from the git tag
         (DELTATOR_VERSION parity: -p:Version=X.Y.Z); fallback = VERSION file rule. -->
    <Version>2.0.0</Version>
    <Product>DeltaTor</Product>
    <Company>Delta-Kronecker</Company>
    <Copyright>MIT License — Delta-Kronecker</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeltaTor.Core\DeltaTor.Core.csproj" />
    <ProjectReference Include="..\DeltaTor.Native\DeltaTor.Native.csproj" />
  </ItemGroup>

  <!-- Bundled assets (parity with Android assets/): bridge lists are the first
       fallback before the network, geoip tables feed the LOCATION cards.
       Resolved from the exe dir at runtime. -->
  <ItemGroup>
    <Content Include="..\..\assets\bridges\*.txt">
      <Link>bridges\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\geoip\*">
      <Link>geoip\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Country flags as images: regional-indicator emoji render as the
         letters "DE" on machines without the emoji font, so the picker
         draws these PNGs instead. -->
    <Content Include="..\..\assets\flags\*.png">
      <Link>flags\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\app\*.ico">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- hev-socks5-tunnel: the data-plane DLL must sit next to DeltaTor.exe so
       P/Invoke can load it. Built by Windows/native/build-hev.sh. -->
  <ItemGroup>
    <Content Include="..\..\native\hev-socks5-tunnel\hev-socks5-tunnel.dll">
      <Link>hev-socks5-tunnel.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
