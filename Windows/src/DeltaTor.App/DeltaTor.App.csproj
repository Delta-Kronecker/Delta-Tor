<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10/11 build 19041+: Se7enTun's Wintun adapter plus its
         netsh/iphlpapi calls, and its TFM itself. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Required by Se7enTun: its diagnostics (Loc) and connection-method code
         use WPF types, so the Windows Desktop framework must be present. -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DeltaTor.App</RootNamespace>
    <AssemblyName>DeltaTor</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The Wintun adapter and route table need Administrator. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Version is overridden by the release workflow from the git tag
         (DELTATOR_VERSION parity: -p:Version=X.Y.Z); fallback = VERSION file rule. -->
    <Version>2.0.0</Version>
    <Product>DeltaTor</Product>
    <Company>Delta-Kronecker</Company>
    <Copyright>MIT License — Delta-Kronecker</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeltaTor.Core\DeltaTor.Core.csproj" />
    <ProjectReference Include="..\DeltaTor.Native\DeltaTor.Native.csproj" />
  </ItemGroup>

  <!-- Bundled assets (parity with Android assets/): bridge lists are the first
       fallback before the network, geoip tables feed the LOCATION cards.
       Resolved from the exe dir at runtime. -->
  <ItemGroup>
    <Content Include="..\..\assets\bridges\*.txt">
      <Link>bridges\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\geoip\*">
      <Link>geoip\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\assets\app\*.ico">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Se7enTun: the engine DLL next to DeltaTor.exe, and its data plane
       (tun2socks.exe + wintun.dll) in exactly Resources\tun2socks\ — the engine
       resolves those from AppContext.BaseDirectory, never from its own folder.
       Fetched by Windows/fetch-binaries.ps1 into Windows/libs/se7entun/. -->
  <ItemGroup>
    <Reference Include="Se7enTun">
      <HintPath>..\..\libs\se7entun\Se7enTun.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <Content Include="..\..\libs\se7entun\Resources\tun2socks\**\*">
      <Link>Resources\tun2socks\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
