<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification action icon: new identity / circuit rotation (two chasing arrows).

  Same rules as ic_notification_disconnect.xml: no android:tint (the system tints
  the row for the light or dark shade), solid fills only, because the icon is
  rendered at 24dp through the same alpha mask as the small icon. A refresh glyph
  with an arrowhead on both arcs reads as "recycle" without needing any tint of
  its own to stay legible at that size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Top arc of the cycle, with the notch the arrowhead sits in. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,4.6C8.9,4.6 6.4,6.4 5.3,9L3.4,9L3.4,4.2L5.2,4.2L5.2,6.4C6.8,4.5 9.2,3.2 12,3.2C15.1,3.2 17.8,4.9 19.3,7.4L16.9,8.2C15.8,6.1 14.1,4.6 12,4.6Z" />
    <!-- Bottom arc, mirrored, with its arrowhead notch. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,19.4C15.1,19.4 17.6,17.6 18.7,15L20.6,15L20.6,19.8L18.8,19.8L18.8,17.6C17.2,19.5 14.8,20.8 12,20.8C8.9,20.8 6.2,19.1 4.7,16.6L7.1,15.8C8.2,17.9 9.9,19.4 12,19.4Z" />
</vector>
