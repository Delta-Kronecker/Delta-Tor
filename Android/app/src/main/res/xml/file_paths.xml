<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Only the generated bridge archives are shareable, and only from the
         exports folder: nothing else in the cache is reachable through this
         provider. -->
    <cache-path
        name="bridge_exports"
        path="exports/" />

    <!-- The downloaded update APK is handed to the system installer through the
         provider, and only from this one folder: nothing else under files/ is
         reachable. -->
    <files-path
        name="updates"
        path="updates/" />
</paths>