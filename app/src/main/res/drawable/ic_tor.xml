<?xml version="1.0" encoding="utf-8"?>
<!--
  The notification small icon.

  Two rules govern this file, and both were broken before:

  1. No android:tint. The system tints a notification icon itself, and it tints it
     dark when the status bar is light. A tint baked into the drawable overrides
     that, so on any phone with a light status bar the icon rendered white on
     white and looked like the app had no icon at all. The colour here is white
     because that is what a notification wants when the system leaves it alone,
     not because it should be forced.

  2. Solid silhouette, no strokes. A notification icon is masked to a shape by the
     launcher, and only the alpha channel survives. The old icon drew its detail
     with strokeWidth=1 inside a 24dp viewport, which is a sub-pixel line at real
     notification sizes: it disappeared on some launchers and got clipped by the
     mask on others. Every detail below is a filled subpath instead.

  The onion is inset to 2..22 of the 24dp viewport rather than filling it. A
  notification icon is drawn inside a shape the launcher chooses, and a drawing
  that runs to the very edge of its canvas gets that edge shaved by the mask,
  which on a circular mask cuts the top and bottom off the onion. The 2dp margin
  is what survives it.

  The onion is one outer ring with the lens cut out by winding direction, plus the
  internal seams as filled slivers, so the shape survives being shrunk to 24dp
  and masked.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Outer onion body with the inner lens removed (opposite winding = hole). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2C6.2,2 3.6,9.3 3.6,13.2C3.6,17.9 7.4,22 12,22C16.6,22 20.4,17.9 20.4,13.2C20.4,9.3 17.8,2 12,2Z M12,4.4C14.9,6.9 15.6,10.9 14.1,13.5C12.7,16.2 11.3,16.2 9.9,13.5C8.4,10.9 9.1,6.9 12,4.4Z" />
    <!-- Internal seams, drawn thick enough to survive the 24dp mask. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.4,6.6L9.9,9.1L8.6,10.4L6.1,7.9Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16.6,6.6L14.1,9.1L15.4,10.4L17.9,7.9Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6.3,15.3L9.2,12.4L10.5,13.7L7.6,16.6Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.7,15.3L14.8,12.4L13.5,13.7L16.4,16.6Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.05,9.3L12.95,9.3L12.95,11.2L11.05,11.2Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.05,13.6L12.95,13.6L12.95,15.5L11.05,15.5Z" />
</vector>