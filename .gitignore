# Gradle. Anchored under Android/ so a bare `build/` can never swallow tracked
# source dirs that happen to sit in a folder named build.
.gradle/
/Android/build/
/Android/*/build/
local.properties

# IDE
.idea/
*.iml
.vscode/
.kotlin/

# OS
.DS_Store
Thumbs.db

# Signing
*.jks
*.keystore
keystore.properties
rel.json
runs.json

# build output
/dist/
/bin/
*.log

# benchmark results (step 0 harness)
/results/

# tor runtime data. Anchored on purpose: a bare data/ would also swallow the
# Android app's own data dirs and any tracked data/ in the tree.
/data/
/Android/app/src/main/assets/data/

# local scratch trees
/portable/

# Android port: fetched fork core (libtor.so) + default torrc + archive and
# digest marker, never committed. libobfs4proxy.so (lyrebird) is not part of
# those releases and stays tracked. Android/fetch-tor.sh repopulates libtor.so
# and assets/torrc on every build.
/Android/app/src/main/jniLibs/*/libtor.so
/Android/app/src/main/jniLibs/.libtor-digest
/Android/app/src/main/assets/torrc
/tor-android-*.zip
