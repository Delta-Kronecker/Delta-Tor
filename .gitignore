# Gradle. Anchored under Android/ so a bare `build/` can never swallow tracked
# source dirs that happen to sit in a folder named build.
.gradle/
/Android/build/
/Android/*/build/
local.properties

# IDE
.idea/
*.iml
.vscode/
.kotlin/

# OS
.DS_Store
Thumbs.db

# Signing
*.jks
*.keystore
keystore.properties
rel.json
runs.json

# build output
/dist/
/bin/
*.log

# benchmark results (step 0 harness)
/results/

# tor runtime data. Anchored on purpose: a bare data/ would also swallow the
# Android app's own data dirs and any tracked data/ in the tree.
/data/
/Android/app/src/main/assets/data/

# local scratch trees
/portable/

# Windows port: fetched Tor Expert Bundle (extracted dir + archive), never committed
/tor-expert-bundle-*
/Windows/vendor/

# Windows port: fetched fork core archive (moving 'latest' tag), never committed
/tor-windows-x86_64.zip

# Windows port: fetched Se7enTun engine (extracted dir + archive), never committed
/Windows/libs/se7entun/
/Se7enTun-*.zip